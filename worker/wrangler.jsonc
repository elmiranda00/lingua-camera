{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lingua-camera",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Served on <name>.<subdomain>.workers.dev (blocked in China without a VPN).
  // For a custom domain, add it under "routes".
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  // The web build is served by this same Worker. run_worker_first sends every
  // request through the Worker so security headers apply to assets too.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingua-camera",
      "database_id": "426a9095-5ba2-4eb1-bdb5-094de91bfef1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_VERSION": "dev",
    "LOOKUP_MODEL": "@cf/qwen/qwen3.8-27b",
    "TTS_MODEL": "@cf/myshell-ai/melotts"
  },

  // Prompt files are bundled as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  "env": {
    // For the browser smoke test (`wrangler dev --env smoke`): no AI or D1 binding,
    // so it runs without a Cloudflare login, e.g. in CI. Never deploy this one.
    "smoke": {
      "vars": {
        "APP_VERSION": "smoke",
        "LOOKUP_MODEL": "unused",
        "TTS_MODEL": "unused"
      }
    }
  }
}
