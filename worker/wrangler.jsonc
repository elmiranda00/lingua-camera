{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lingua-camera",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // M0: serve on <name>.<account>.workers.dev. Add the custom domain under
  // "routes" before the China test (workers.dev is blocked in mainland China).
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  // The web build is served by this same Worker. run_worker_first sends every
  // request through the Worker so security headers apply to assets too.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "ai": { "binding": "AI" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingua-camera",
      // Replace with the id printed by `npx wrangler d1 create lingua-camera`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_VERSION": "dev",
    "LOOKUP_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "TTS_MODEL": "@cf/myshell-ai/melotts"
  },

  // Prompt files are bundled as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
