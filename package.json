{
  "name": "lexi-lens",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n worker,web -c yellow,cyan \"npm run dev -w @lexi/worker\" \"npm run dev -w @lexi/web\"",
    "build": "npm run models:fetch && npm run build -w @lexi/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "models:fetch": "node scripts/fetch-models.ts",
    "db:migrate:local": "npm run db:migrate:local -w @lexi/worker",
    "db:migrate:remote": "npm run db:migrate:remote -w @lexi/worker",
    "deploy": "npm run build && npm run deploy -w @lexi/worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
