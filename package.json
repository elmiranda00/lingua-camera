{
  "name": "lingua-camera",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "worker",
    "web"
  ],
  "scripts": {
    "assets": "node scripts/ocr-assets.mjs",
    "dev": "npm run assets && concurrently -k -n worker,web -c yellow,cyan \"npm run dev -w @lingua-camera/worker\" \"npm run dev -w @lingua-camera/web\"",
    "build": "npm run assets && npm run build -w @lingua-camera/web",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "db:migrate:local": "npm run db:migrate:local -w @lingua-camera/worker",
    "db:migrate:remote": "npm run db:migrate:remote -w @lingua-camera/worker",
    "deploy": "npm run build && npm run deploy -w @lingua-camera/worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
